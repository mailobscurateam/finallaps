<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recover Identity | Nexus Prime</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root { --math-primary: #ec4899; --math-dark: #09090b; }
        body { font-family: 'Outfit', sans-serif; background-color: var(--math-dark); color: #f4f4f5; overflow-x: hidden; }
        .mono { font-family: 'JetBrains Mono', monospace; }
        #math-canvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -10; }
        .glass-panel { background: rgba(24, 24, 27, 0.4); backdrop-filter: blur(40px); border: 1px solid rgba(255, 255, 255, 0.08); position: relative; }
        .input-field { background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.08); transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
        .input-field:focus { border-color: var(--math-primary); background: rgba(236, 72, 153, 0.03); outline: none; }
        .gradient-btn { background: linear-gradient(135deg, #ec4899 0%, #be185d 100%); transition: all 0.4s; }
        .gradient-btn:hover { transform: translateY(-2px); box-shadow: 0 15px 30px -10px rgba(236, 72, 153, 0.5); }
        .spinner { width: 20px; height: 20px; border: 2px solid rgba(255,255,255,0.2); border-top-color: #fff; border-radius: 50%; animation: spin 0.8s linear infinite; display: none; }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen py-12 px-6">
    <div id="math-canvas"></div>
    <div class="w-full max-w-md relative z-10">
        <div class="text-center mb-10">
            <h1 class="text-5xl font-black tracking-tighter mb-3">NEXUS<span class="text-pink-500">PRIME</span></h1>
            <p class="mono text-[10px] uppercase tracking-[0.5em] text-zinc-500 text-center">Identity Recovery</p>
        </div>

        <div class="glass-panel rounded-[2.5rem] p-10">
            <header class="mb-10 text-center">
                <h2 class="text-3xl font-bold tracking-tight">Request <span class="text-pink-500">Reset</span></h2>
                <p class="text-zinc-500 text-sm mt-2">Enter your email to receive a secure recovery link.</p>
            </header>
            
            <form id="forgot-form" class="space-y-6">
                <div class="input-group">
                    <label class="block mono text-[10px] uppercase tracking-[0.2em] text-zinc-500 mb-2.5 ml-1">Terminal Email</label>
                    <div class="relative">
                        <i data-lucide="at-sign" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-600"></i>
                        <input type="email" id="email" required placeholder="student@gmail.com" class="input-field w-full py-4.5 pl-12 pr-4 rounded-2xl text-sm">
                    </div>
                </div>

                <div id="status-msg" class="hidden">
                    <div class="flex items-center space-x-3 p-4 rounded-2xl border text-xs" id="status-container">
                        <span id="status-text"></span>
                    </div>
                </div>

                <button type="submit" id="submit-btn" class="gradient-btn w-full py-5 rounded-2xl font-bold text-xs uppercase tracking-[0.3em] flex items-center justify-center space-x-3 text-white">
                    <span>Send Link</span>
                    <div class="spinner" id="btn-spinner"></div>
                </button>
            </form>

            <div class="mt-8 text-center">
                <a href="/login" class="text-zinc-500 hover:text-pink-500 text-xs transition-colors italic">Return to login terminal</a>
            </div>
        </div>
    </div>

    <script>
        const SUPABASE_URL = 'https://tsaoxjzvhxiggntibpui.supabase.co';
        const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRzYW94anp2aHhpZ2dudGlicHVpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzU4NDQ2OTAsImV4cCI6MjA5MTQyMDY5MH0.Q5Iu51O3NK4k2kcc_GoegnyAYIFIs2SUkQOV10qp2jI';
        const supabaseInstance = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        document.getElementById('forgot-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = document.getElementById('email').value;
            const spinner = document.getElementById('btn-spinner');
            const submitBtn = document.getElementById('submit-btn');
            const statusMsg = document.getElementById('status-msg');
            const statusText = document.getElementById('status-text');
            const statusContainer = document.getElementById('status-container');

            spinner.style.display = 'block';
            submitBtn.disabled = true;

            const { error } = await supabaseInstance.auth.resetPasswordForEmail(email, {
                redirectTo: window.location.origin + '/reset-password',
            });

            spinner.style.display = 'none';
            statusMsg.classList.remove('hidden');

            if (error) {
                statusContainer.className = 'flex items-center p-4 rounded-2xl bg-red-500/10 border-red-500/20 text-red-400 text-xs';
                statusText.textContent = error.message;
                submitBtn.disabled = false;
            } else {
                statusContainer.className = 'flex items-center p-4 rounded-2xl bg-green-500/10 border-green-500/20 text-green-400 text-xs';
                statusText.textContent = "Recovery link deployed to your inbox.";
                document.getElementById('email').value = '';
            }
        });

        // Basic Three.js Bg
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 100;
        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        document.getElementById('math-canvas').appendChild(renderer.domElement);
        const geo = new THREE.BufferGeometry();
        const pos = new Float32Array(500 * 3);
        for(let i=0; i<500*3; i++) pos[i] = (Math.random() - 0.5) * 300;
        geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
        const pts = new THREE.Points(geo, new THREE.PointsMaterial({ size: 1, color: 0xec4899, opacity: 0.2, transparent: true }));
        scene.add(pts);
        function animate() { requestAnimationFrame(animate); pts.rotation.y += 0.001; renderer.render(scene, camera); }
        animate();
        lucide.createIcons();
    </script>
</body>
</html>
